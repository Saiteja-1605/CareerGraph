# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Example: mongodb://127.0.0.1:27017/careergraph
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/careergraph?retryWrites=true&w=majority
# (Note: In development, an embedded in-memory MongoDB will automatically start if no local daemon is reachable)
MONGO_URI=mongodb://127.0.0.1:27017/careergraph

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_careergraph_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
