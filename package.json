{
  "name": "careergraph-monorepo",
  "version": "1.0.0",
  "description": "CareerGraph - Full-Stack Placement & Skill Management Platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:backend && npm run build:frontend",
    "seed": "cd backend && npm run seed"
  },
  "keywords": [
    "career",
    "placement",
    "skills",
    "dsa-tracker",
    "portfolio",
    "react",
    "express",
    "mongodb"
  ],
  "author": "CareerGraph Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
